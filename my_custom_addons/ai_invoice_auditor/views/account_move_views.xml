<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We are 'inheriting' the existing invoice form view -->
    <record id="view_move_form_ai_inherit" model="ir.ui.view">
        <field name="name">account.move.form.ai.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- Find the 'payment_reference' field and put our field after it -->
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="bypass_ai_check"/>
            </xpath>

        </field>
    </record>
</odoo>