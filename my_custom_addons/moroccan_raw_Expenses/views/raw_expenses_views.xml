<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_moroccan_raw_expenses_tree" model="ir.ui.view">

        <field name="name">moroccan.raw.expenses.tree</field>
        <field name="model">moroccan.raw.expenses</field> <!-- Points to your brand-new custom model table -->
        <field name="arch" type="xml">

            <list string="Moroccan Raw Expenses Spreadsheet">
                    <!-- We list the columns we want to show side-by-side in our spreadsheet row -->
                    <field name="name"/>
                    <field name="date"/>
                    <field name="ammount"/>
                    <field name="state"/>
                    
            </list>

        </field>
    
    </record>


    <record id="view_moroccan_raw_expenses_form" model="ir.ui.view">
        <field name="name">moroccan.raw.expenses.form</field>
        <field name="model">moroccan.raw.expenses</field>
        <field name="arch" type="xml">

            <form string="Edit Expense">
                    <!-- <sheet> creates the beautiful white paper canvas container look -->
                    <sheet>
                        <!-- <group> tags act like grid columns to align fields side-by-side beautifully -->
                        <group>
                            <!-- Left Column Grid Group -->
                            <group string="expense">
                                <field name="name"/>
                            </group>
                            <!-- Right Column Grid Group -->
                            <group string="ammount">
                                <field name="ammount"/>
                                <field name="date" readonly="1"/> <!-- readonly="1" blocks users from typing in it -->
                            </group>
                        </group>
                    </sheet>
            </form>
        </field>
        

    </record>

    <record id="action_moroccan_raw_expenses" model="ir.actions.act_window">
        <field name="name">raw expenses</field>
        <field name="res_model">moroccan.raw.expenses</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_moroccan_raw_expenses_root"
              name="raw expenses"
              parent="account.menu_finance_entries" 
              action="action_moroccan_raw_expenses"          
              sequence="50"/> <!-- Controls positioning. Higher numbers push the button lower down the menu list -->

</odoo>