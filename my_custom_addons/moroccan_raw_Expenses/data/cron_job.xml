<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- create a record in Odoo's built-in ir.cron table -->
        <record id="ir_cron_cleanup_draft_expenses" model="ir.cron">
            <field name="name">Raw Expenses: Cleanup Old Drafts</field>
            <field name="model_id" ref="model_moroccan_raw_expenses"/>
            <field name="state">code</field>
            
            <!-- the function/method code that this cron will be executing -->
            <field name="code">model._cron_cleanup_old_drafts()</field>
            
            <!-- How often should it run? (Every 1 Day) -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            
            <!-- this cron job runs infinitely by default -->
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>